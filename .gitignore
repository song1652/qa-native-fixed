# Python
__pycache__/
*.pyc
.venv/

# Runtime state & logs
state/
logs/
pending_impl.json

# Test outputs (screenshots/reports are now tracked)
tests/traces/
# 단위 E2E(tests/unit) 실패 스크린샷 — 파이프라인 결과가 아니라 로컬 디버깅용
tests/screenshots/tc_library__*
tests/screenshots/dashboard__*

# Log files in parallel/
parallel/*.txt

# Cache
.pytest_cache/

# Environment
.env

# Credentials / sensitive test data
# test_data/: 프로덕트별 실제 데이터는 gitignored, *.example.json만 추적
test_data/*.json
!test_data/*.example.json
!test_data/README.md
# 레거시 위치 (이전 버전 호환)
config/test_data.json
config/jira_config.json
# TC 스튜디오 연결 자격증명 (Phase 3)
config/confluence_config.json
config/figma_config.json


# macOS
.DS_Store

# Tools
.claude/scheduled_tasks.lock
.claude/*.lock
.claude/settings.local.json
.playwright-mcp/

# OMC runtime state
.omc/state/
.omc/sessions/
.omc/continuation-count.json
.omc/swarm-state.json
